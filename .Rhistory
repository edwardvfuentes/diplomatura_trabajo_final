library(plm)
library(modelsummary)
library(fixest)
source("./input/clean_datasets.R")
# Modelos OLS
# Consumo ~ Ingresos + Activos
ols_estandar_1 <- lm(log(pce + 1) ~ log(fincome1_per + 1) + total_asset, data=famecon_family_df)
ols_estandar_2 <- lm(log(pce + 1) ~ log(fincome1_per + 1) + total_asset + tipo_familia, data=famecon_family_df)
ols_estandar_3 <- lm(log(pce + 1) ~ log(fincome1_per + 1) + total_asset + tipo_familia + hukou_reform, data=famecon_family_df)
lista_estandar_models <- list(
"ols_1" = ols_estandar_1,
"ols_2" = ols_estandar_2,
"ols_3" = ols_estandar_3
)
modelsummary(
lista_estandar_models,
stars = TRUE,
title = "Estimaciones de mínimos cuadrados ordinarios para el logaritmo de consumo total",
notes = "Fuente: Elaboración propia en base a CFPS",
output = "./output/resumen_ols_consumo.png"
)
# Consumo ~ Ingresos + Activos 2010-2014 frente a 2016-2022
ols_year_1 <- lm(log(pce + 1) ~ log(fincome1_per + 1) + total_asset + tipo_familia,
data=famecon_family_df %>% filter(year %in% c(2010, 2012, 2014)))
ols_year_2 <- lm(log(pce + 1) ~ log(fincome1_per + 1) + total_asset + tipo_familia,
data=famecon_family_df %>% filter(year %in% c(2016, 2018, 2020, 2022)))
lista_year_models <- list(
"ols_1" = ols_year_1,
"ols_2" = ols_year_2
)
modelsummary(
lista_estandar_models,
stars = TRUE,
title = "MCO para el logaritmo de consumo: Antes y después de la reforma de 2014",
notes = "Fuente: Elaboración propia en base a CFPS",
output = "./output/resumen_ols_consumo_reforma.png"
)
lista_year_models <- list(
"ols_1" = ols_year_1,
"ols_2" = ols_year_2
)
modelsummary(
lista_year_models,
stars = TRUE,
title = "MCO para el logaritmo de consumo: Antes y después de la reforma de 2014",
notes = "Fuente: Elaboración propia en base a CFPS",
output = "./output/resumen_ols_consumo_reforma.png"
)
modelsummary(
lista_year_models,
stars = TRUE,
title = "MCO para el logaritmo de consumo: Antes y después de la reforma de 2014",
goof_map = c("r.squared", "adj.r.squared", "nobs", "rmse"),
notes = "Fuente: Elaboración propia en base a CFPS",
output = "./output/resumen_ols_consumo_reforma.png"
)
modelsummary(
lista_year_models,
stars = TRUE,
title = "MCO para el logaritmo de consumo: Antes y después de la reforma de 2014",
goof_map = c("r.squared", "adj.r.squared", "nobs", "rmse"),
notes = "Fuente: Elaboración propia en base a CFPS",
output = "./output/resumen_ols_consumo_reforma.png"
)
